# Copie ce fichier en .env et remplis les vraies valeurs (jamais commit .env)

PORT=3003
NODE_ENV=production

# Connexion à la base PostgreSQL déjà présente sur le VPS
# On crée une base dédiée "tadaksahak" à l'intérieur du même serveur Postgres
DATABASE_URL=postgres://tadaksahak_user:CHANGE_MOI@127.0.0.1:5432/tadaksahak

# Origines autorisées à appeler l'API (le front statique)
CORS_ORIGIN=https://tadaksahak-learning.com

# Secret pour signer les tokens admin (génère une valeur longue et aléatoire)
JWT_SECRET=CHANGE_MOI_EN_VALEUR_ALEATOIRE_LONGUE

# Identifiants du compte admin unique (validation des contributions)
ADMIN_USERNAME=hamadine
ADMIN_PASSWORD_HASH=CHANGE_MOI_HASH_BCRYPT
